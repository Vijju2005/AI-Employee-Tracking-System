# ============================================================
# EBT System — Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ============================================================

# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-very-long-random-secret-key-here

# WTForms CSRF secret (can be same as SECRET_KEY or a separate value)
WTF_CSRF_SECRET_KEY=your-csrf-secret-key-here

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ebt_system
DB_USER=ebt_app
DB_PASSWORD=your-ebt-app-password-here

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=1

# Application settings
APP_NAME=EBT System
TIMEZONE=Asia/Kolkata

# Email / SMTP configuration (Flask-Mail)
# Set MAIL_SUPPRESS_SEND=false to enable real dispatch in production
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@ebtsystem.com
MAIL_SUPPRESS_SEND=true

# Test database (used by pytest — separate from production)
TEST_DB_NAME=ebt_system_test
TEST_DB_USER=ebt_app
TEST_DB_PASSWORD=your-ebt-app-password-here
